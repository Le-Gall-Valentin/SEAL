<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exclusions SpotBugs. Chaque entrée dit pourquoi le signalement est un faux positif ;
  une vulnérabilité réelle se corrige, elle ne s'exclut pas.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      IMPROPER_UNICODE signale tout appel à Normalizer.normalize. Le CDC (section 7.2) impose
      text(s) = bytes(UTF-8(NFC(s))), et Canonical.text suit déjà l'ordre que la règle recommande :
      normaliser d'abord, valider ensuite (encodeur UTF-8 strict, ADR 0006). Exclusion limitée à
      cette méthode : tout autre appel à la normalisation reste signalé.
    -->
    <Match>
        <Class name="fr.vlegall.seal.crypto.Canonical"/>
        <Method name="text"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
      IMPROPER_UNICODE, même raison : Unicode regroupe les transformations de SEAL (NFC de SEC-01, NFKC d'AUTH-11,
      minuscules et pliage d'AUTH-04), et chaque appelant valide la valeur transformée, jamais la saisie brute.
      Exclusion limitée à ces méthodes : toute autre méthode, même dans Unicode, reste signalée.
    -->
    <Match>
        <Class name="fr.vlegall.seal.common.Unicode"/>
        <Or>
            <Method name="nfc"/>
            <Method name="nfkc"/>
            <Method name="lowerCase"/>
            <Method name="foldWithoutMarks"/>
        </Or>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
      SPRING_ENDPOINT n'est pas une faille : FindSecBugs l'émet sur chaque contrôleur pour qu'il soit relu
      (ADR 0011). Une entrée par contrôleur relu, avec le test qui vérifie son contrôle d'accès (QA-05) ;
      jamais d'exclusion globale.
    -->
    <!-- GET /api/v1/csrf, public par nature (AUTH-60) : CsrfIT. -->
    <Match>
        <Class name="fr.vlegall.seal.security.web.CsrfController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth : me (toute session), register (anonyme), username-availability (anonyme ou session complète) :
         RegistrationIT. -->
    <Match>
        <Class name="fr.vlegall.seal.identity.infrastructure.web.AccountController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/login (anonyme seulement) et /logout (toute session) : LoginIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.SessionController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/verify-email, /resend et /change, session restreinte seulement : EmailVerificationIT. -->
    <Match>
        <Class name="fr.vlegall.seal.identity.infrastructure.web.EmailVerificationController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /error, dispatch d'erreur du conteneur, sans donnée ni effet (ADR 0011) : CsrfIT.auth60ErrorEndpointIsCsrfProtected. -->
    <Match>
        <Class name="fr.vlegall.seal.common.web.ProblemDetailsErrorController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!--
      SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING : /error accepte toutes les méthodes, car le conteneur y renvoie la
      requête d'origine avec sa méthode. Aucun effet de bord ; le filtre CSRF refuse déjà toute requête non sûre
      envoyée directement sur /error (CsrfIT). Exclusion limitée à cette classe (ADR 0011).
    -->
    <Match>
        <Class name="fr.vlegall.seal.common.web.ProblemDetailsErrorController"/>
        <Bug pattern="SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING"/>
    </Match>

    <!--
      SERVLET_HEADER_USER_AGENT : l'agent peut être falsifié, et SEAL ne s'en sert pour aucune décision. Il est
      rangé assaini et tronqué à 512 caractères dans security_events (SEC-20, colonne user_agent du CDC), comme
      simple indication (ADR 0011). Exclusion limitée à cette méthode.
    -->
    <Match>
        <Class name="fr.vlegall.seal.security.journal.SecurityJournal"/>
        <Method name="userAgent"/>
        <Bug pattern="SERVLET_HEADER_USER_AGENT"/>
    </Match>
</FindBugsFilter>
