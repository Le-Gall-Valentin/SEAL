<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exclusions SpotBugs. Chaque entrée dit pourquoi le signalement est un faux positif ;
  une vulnérabilité réelle se corrige, elle ne s'exclut pas.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      IMPROPER_UNICODE signale tout appel à Normalizer.normalize. Le CDC (section 7.2) impose
      text(s) = bytes(UTF-8(NFC(s))), et Canonical.text suit déjà l'ordre que la règle recommande :
      normaliser d'abord, valider ensuite (encodeur UTF-8 strict, ADR 0006). Exclusion limitée à
      cette méthode : tout autre appel à la normalisation reste signalé.
    -->
    <Match>
        <Class name="fr.vlegall.seal.crypto.Canonical"/>
        <Method name="text"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
      IMPROPER_UNICODE, même raison : Unicode regroupe les transformations de SEAL (NFC de SEC-01, NFKC d'AUTH-11,
      minuscules et pliage d'AUTH-04), et chaque appelant valide la valeur transformée, jamais la saisie brute.
      Exclusion limitée à ces méthodes : toute autre méthode, même dans Unicode, reste signalée.
    -->
    <Match>
        <Class name="fr.vlegall.seal.common.Unicode"/>
        <Or>
            <Method name="nfc"/>
            <Method name="nfkc"/>
            <Method name="lowerCase"/>
            <Method name="foldWithoutMarks"/>
        </Or>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
      SERVLET_PARAMETER : les paramètres code et error du retour OAuth ne sont lus que pour savoir si le code d'erreur
      de Spring vient du navigateur ; ils ne sont ni journalisés, ni renvoyés, ni stockés. Seul un code d'une liste
      fermée atteint le journal (SEC-20, OAuthCallbackSessionIT, OAuthAttackIT). Exclusion limitée à cette méthode (ADR
      0011).
    -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.security.OAuthLoginFailureHandler"/>
        <Method name="cause"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>

    <!--
      SERVLET_HEADER : Fetch Metadata (ADR 0032, point 3) lit les en-têtes Sec-Fetch-* et Sec-Purpose pour écarter ce
      que le navigateur marque comme sous-requête, départ d'une autre origine, préchargement ou prérendu. Un client qui
      les falsifie pour imiter une navigation est compté comme toute requête sans ces en-têtes : rien n'est contourné.
      Les valeurs ne sont que comparées à des constantes, ou leur présence lue (OAuthAttackIT). Exclusion limitée à ces
      trois méthodes (ADR 0011).
    -->
    <Match>
        <Class name="fr.vlegall.seal.security.ratelimit.OAuthNavigationRateLimitFilter"/>
        <Or>
            <Method name="expectedNavigation"/>
            <Method name="isPresentAndNot"/>
            <Method name="isSpeculative"/>
        </Or>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!--
      SPRING_ENDPOINT n'est pas une faille : FindSecBugs l'émet sur chaque contrôleur pour qu'il soit relu
      (ADR 0011). Une entrée par contrôleur relu, avec le test qui vérifie son contrôle d'accès (QA-05) ;
      jamais d'exclusion globale.
    -->
    <!-- GET /api/v1/csrf, public par nature (AUTH-60) : CsrfIT. -->
    <Match>
        <Class name="fr.vlegall.seal.security.web.CsrfController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth : me (toute session), register (anonyme), username-availability (anonyme ou session complète) :
         RegistrationIT. -->
    <Match>
        <Class name="fr.vlegall.seal.identity.infrastructure.web.AccountController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/account : profile, email et email/confirm (session complète ; sudo pour email, ADR 0034) :
         AccountProfileIT, EmailChangeIT. -->
    <Match>
        <Class name="fr.vlegall.seal.identity.infrastructure.web.AccountSettingsController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/friend-requests (session complète, ADR 0037) : FriendRequestSendIT, FriendRequestTransitionsIT,
         FriendListsIT. -->
    <Match>
        <Class name="fr.vlegall.seal.friends.infrastructure.web.FriendRequestsController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/conversations (session complète, ADR 0039) : ConversationsIT. -->
    <Match>
        <Class name="fr.vlegall.seal.conversations.infrastructure.web.ConversationsController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/friends (session complète, ADR 0037) : FriendListsIT. -->
    <Match>
        <Class name="fr.vlegall.seal.friends.infrastructure.web.FriendsController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/reauth (session complète, ADR 0034) : ReauthenticationIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.ReauthenticationController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- GET /oauth2/authorization/{id} non résolu par Spring : 404 pour l'anonyme, retour aux paramètres pour la session
         complète (ADR 0034, point 2), adresses constantes : OAuthReauthenticationIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.OAuthStartController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- GET /api/v1/account/identities (session complète, ADR 0035) : AccountIdentitiesIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.AccountIdentitiesController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/account/password (session complète, ACC-01) : PasswordChangeIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.AccountPasswordController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/login (anonyme seulement) et /logout (toute session) : LoginIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.SessionController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/providers (anonyme ou session complète, AUTH-35), /oauth/pending et /oauth/complete (anonyme
         seulement, AUTH-32) : OAuthProvidersIT, OAuthAuthorizationRequestIT, OAuthRegistrationIT,
         WebAuthorizationConventionsIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.OAuthController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/password-reset/request, /inspect et /confirm (anonyme seulement, ADR 0022) : PasswordResetIT. -->
    <Match>
        <Class name="fr.vlegall.seal.authentication.infrastructure.web.PasswordResetController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/auth/verify-email, /resend et /change, session restreinte seulement : EmailVerificationIT. -->
    <Match>
        <Class name="fr.vlegall.seal.identity.infrastructure.web.EmailVerificationController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- GET des adresses des écrans (ADR 0024, point 5) : renvoient le client compilé, sans donnée ni effet, à toute
         session comme à l'anonyme ; liste fermée, POST refusé : ClientRoutesIT, WebAuthorizationConventionsIT. -->
    <Match>
        <Class name="fr.vlegall.seal.security.web.ClientRoutesController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- GET /api/v1/pki/ca, clé publique de l'Autorité, session complète seulement (ADR 0025, point 9) : PkiIT. -->
    <Match>
        <Class name="fr.vlegall.seal.pki.infrastructure.web.PkiController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /api/v1/keys : clés du seul compte de la session, session complète seulement, sans identifiant de compte dans
         l'URL ni le corps (ADR 0025, point 9) ; réinitialisation en mode sudo, vérifié par le handler (ADR 0036) :
         IdentityPublicationIT, SubkeyPublicationIT, VaultIT, IdentityResetIT. -->
    <Match>
        <Class name="fr.vlegall.seal.keys.infrastructure.web.KeysController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- GET /api/v1/users/{userId}/keys : clés de l'appelant, d'un ami ou d'un membre d'un groupe commun, session
         complète seulement ; 404 pour tout autre compte, contrôlé dans le handler (ADR 0029, point 4 ; ADR 0037,
         point 7 ; ADR 0039, point 7) : UserKeysIT, ReadUserKeysHandlerTest. -->
    <Match>
        <Class name="fr.vlegall.seal.keys.infrastructure.web.UserKeysController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- /error, dispatch d'erreur du conteneur, sans donnée ni effet (ADR 0011) : CsrfIT.auth60ErrorEndpointIsCsrfProtected. -->
    <Match>
        <Class name="fr.vlegall.seal.common.web.ProblemDetailsErrorController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!--
      SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING : /error accepte toutes les méthodes, car le conteneur y renvoie la
      requête d'origine avec sa méthode. Aucun effet de bord ; le filtre CSRF refuse déjà toute requête non sûre
      envoyée directement sur /error (CsrfIT). Exclusion limitée à cette classe (ADR 0011).
    -->
    <Match>
        <Class name="fr.vlegall.seal.common.web.ProblemDetailsErrorController"/>
        <Bug pattern="SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING"/>
    </Match>

    <!--
      PATH_TRAVERSAL_IN : le dossier de la clé de l'Autorité vient de seal.data-dir, réglé par l'exploitant
      (SEAL_DATA_DIR, KEY-10), jamais d'une requête ; les noms de fichiers sont des constantes (ADR 0025, point 12).
      CRLF_INJECTION_LOGS : seule l'empreinte de la CA est journalisée, 64 chiffres hexadécimaux calculés par SEAL,
      sans retour à la ligne possible. Exclusions limitées à cette classe.
    -->
    <Match>
        <Class name="fr.vlegall.seal.pki.infrastructure.ca.FileCaKeyStore"/>
        <Or>
            <Bug pattern="PATH_TRAVERSAL_IN"/>
            <Bug pattern="CRLF_INJECTION_LOGS"/>
        </Or>
    </Match>

    <!--
      CRLF_INJECTION_LOGS : l'alerte A09 d'une signature refusée ne porte que l'UUID du compte, tiré de la session
      (chiffres hexadécimaux et tirets), et une route choisie parmi des constantes ; aucune valeur reçue (ADR 0025,
      point 10). Exclusion limitée à cette méthode.
    -->
    <Match>
        <Class name="fr.vlegall.seal.keys.infrastructure.security.KeysJournalAdapter"/>
        <Method name="signatureRejected"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      SERVLET_HEADER_USER_AGENT : l'agent peut être falsifié, et SEAL ne s'en sert pour aucune décision. Il est
      rangé assaini et tronqué à 512 caractères dans security_events (SEC-20, colonne user_agent du CDC), comme
      simple indication (ADR 0011). Exclusion limitée à cette méthode.
    -->
    <Match>
        <Class name="fr.vlegall.seal.security.journal.SecurityJournal"/>
        <Method name="userAgent"/>
        <Bug pattern="SERVLET_HEADER_USER_AGENT"/>
    </Match>
</FindBugsFilter>
