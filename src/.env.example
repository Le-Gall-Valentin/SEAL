# Variables d'environnement de SEAL (SEC-22). Ne commitez jamais .env.
# scripts/gen-certs.sh (ou gen-certs.ps1 sous Windows) copie ce fichier en .env et remplit les secrets vides.

# Clé serveur de 32 octets en base64 : chiffrera au repos les secrets TOTP (AUTH-41).
SEAL_DATA_KEY=

# Mot de passe du rôle PostgreSQL de SEAL, utilisé par les services db et app de compose.yaml.
SEAL_DB_PASSWORD=
