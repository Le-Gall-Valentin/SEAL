# Variables d'environnement de SEAL (SEC-22). Ne commitez jamais .env.
# scripts/gen-certs.sh (ou gen-certs.ps1 sous Windows) copie ce fichier en .env et remplit les secrets vides.

# Clé serveur de 32 octets en base64 : chiffrera au repos les secrets TOTP (AUTH-41).
SEAL_DATA_KEY=

# Poivre des mots de passe, 32 octets en base64 (AUTH-13, ADR 0026). À sauvegarder : le perdre rend tous les
# mots de passe inutilisables, et chaque compte devrait passer par « mot de passe oublié ».
SEAL_PASSWORD_PEPPER=

# Mot de passe du rôle PostgreSQL de SEAL, utilisé par les services db et app de compose.yaml.
SEAL_DB_PASSWORD=

# Connexion avec Google et GitHub (AUTH-30 à AUTH-35, ADR 0032), facultative : sans ces valeurs, SEAL démarre et masque
# les boutons du fournisseur (OPS-03). Renseignez l'identifiant et le secret d'un même fournisseur, ou aucun des deux.
# Création des applications et URI de redirection : README, « Connexion avec Google et GitHub ».
SEAL_OAUTH_GOOGLE_CLIENT_ID=
SEAL_OAUTH_GOOGLE_CLIENT_SECRET=
SEAL_OAUTH_GITHUB_CLIENT_ID=
SEAL_OAUTH_GITHUB_CLIENT_SECRET=
